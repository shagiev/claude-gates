#!/bin/sh
# gates-run: trusted Claude/Kimi resolver + isolated interpreter. Не использует PATH/HOME caller.
set -u
SCRIPT="${1:?usage: gates-run <script.py> [args...]}"
shift
PY=""
for candidate in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
  if [ -f "$candidate" ] && [ -x "$candidate" ] && [ ! -L "$candidate" ] \
      && [ -z "$(/usr/bin/find "$candidate" -perm -022 -print -quit)" ] \
      && [ -z "$(/usr/bin/find "$candidate" ! -user root -print -quit)" ]; then
    PY="$candidate"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "[gates] нет trusted system Python — операция ПРЕРВАНА (fail-closed)." >&2
  exit 1
fi
GATE_HOME=$("$PY" -I -B -c 'import os,pwd; print(pwd.getpwuid(os.getuid()).pw_dir)')
BOOT_DIR="$GATE_HOME/.local/lib/claude-gates"
BOOT="$BOOT_DIR/kimi_install.py"
BOOT_SHA256=a669a28804370f4134ea2cef0ea598c8e323c549076643ffecb5ebc8675973ae
GATES_UID=$(/usr/bin/id -u)
for directory in "$GATE_HOME" "$GATE_HOME/.local" "$GATE_HOME/.local/lib" "$BOOT_DIR"; do
  if [ ! -d "$directory" ] || [ -L "$directory" ] \
      || [ -n "$(/usr/bin/find "$directory" -maxdepth 0 -perm -022 -print -quit)" ] \
      || [ -n "$(/usr/bin/find "$directory" -maxdepth 0 ! -user "$GATES_UID" -print -quit)" ]; then
    echo "[gates] gate-owned bootstrap path отсутствует или небезопасен — запусти /gates-init." >&2
    exit 1
  fi
done
if [ ! -f "$BOOT" ] || [ -L "$BOOT" ] \
    || [ -n "$(/usr/bin/find "$BOOT" -perm -022 -print -quit)" ] \
    || [ -n "$(/usr/bin/find "$BOOT" ! -user "$GATES_UID" -print -quit)" ]; then
  echo "[gates] $BOOT отсутствует или небезопасен — запусти /gates-init." >&2
  exit 1
fi
P=$("$PY" -I -B -c 'import hashlib,sys
path, expected = sys.argv[1:3]
data = open(path, "rb").read()
if hashlib.sha256(data).hexdigest() != expected:
    raise SystemExit("bootstrap digest mismatch — run /gates-init")
sys.argv = [path] + sys.argv[3:]
exec(compile(data, path, "exec"), {"__name__": "__main__", "__file__": path})' \
  "$BOOT" "$BOOT_SHA256" select "$SCRIPT")
RC=$?
if [ "$RC" -ne 0 ]; then
  echo "[gates] установка отклонена trusted resolver — операция ПРЕРВАНА (fail-closed)." >&2
  exit 1
fi
if [ -z "$P" ]; then
  echo "[gates] активная установка gates не найдена ни Claude, ни Kimi — операция ПРЕРВАНА." >&2
  echo "[gates] Claude: /plugin install gates@lenar-gates; Kimi: /plugins install <path>/plugins/gates" >&2
  echo "[gates] Обход коммита (аудируется): LADDER_SKIP=1 [LADDER_SKIP_REASON=\"...\"] git commit ..." >&2
  exit 1
fi
exec "$PY" -I -B "$P" "$@"
