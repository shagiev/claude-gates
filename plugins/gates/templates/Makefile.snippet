# ═══ gates: ревью-гейты (плагин gates@lenar-gates) — вставь в свой Makefile ═══
# Деплой у каждого проекта свой: этот snippet — каркас. Обязательные элементы:
#   deploy: ... check-reviewed ...   (гейт — prerequisite деплоя)
#   deploy-lock (atomic mkdir + trap; на macOS НЕТ flock CLI — только mkdir)
#   check-decision ПРЯМО перед выкаткой (rsync/push)
#   запись .claude/.last-deployed-sha ТОЛЬКО после успешной пост-деплой верификации
# NB: в Makefile каждый '$' шелла пишется как '$$'.
# Панель ревьюеров — обязательная пара Codex+Claude; REVIEW_PROVIDER её НЕ понижает
# (легаси-значения codex|cursor|both блокируют деплой). Аварийный выход — CODEX_REVIEW_SKIP=1.
# ВАЖНО: выкатывать нужно АРТЕФАКТ из verify-deployable, а не рабочее дерево. Голые
# `git rev-parse`/`git status` здесь не годятся: PATH-шим вернёт одобренный SHA и пустой
# статус после подмены дерева. verify-deployable делает те же проверки доверенным git и
# строит неизменяемый артефакт из отревьюенного коммита.

setup-hooks:
	@git config core.hooksPath .githooks
	@echo "✅ core.hooksPath=.githooks — ladder pre-commit/post-commit активны"

# ladder-range + Codex-ревью диффа baseline..HEAD (fail-closed; чистое дерево обязательно)
check-reviewed:
	@bash .githooks/gates-run codex_review_gate.py check-reviewed

deploy: check-reviewed   # + твои проверки: check-committed test mypy coverage
	@mkdir -p logs; \
	if ! mkdir logs/.deploy.lock.d 2>/dev/null; then \
		echo "❌ другой make deploy уже идёт (deploy-lock). Если он завис/убит -9: rmdir logs/.deploy.lock.d"; \
		exit 1; \
	fi; \
	trap 'rmdir logs/.deploy.lock.d 2>/dev/null' EXIT; \
	trap 'exit 130' INT TERM; \
	ART=$$(bash .githooks/gates-run codex_review_gate.py verify-deployable) || exit 1; \
	GATES_ARTIFACT=$$(printf '%s\n' "$$ART" | sed -n 's/^GATES_ARTIFACT=//p'); \
	REVIEWED_SHA=$$(cat .claude/.last-reviewed-sha); \
	if [ -z "$$GATES_ARTIFACT" ]; then \
		echo "❌ verify-deployable не выдал артефакт — гарантия не действует, прерываю"; \
		exit 1; \
	fi; \
	if ! bash .githooks/gates-run codex_review_gate.py check-decision; then \
		echo "❌ решение ревью устарело (конкурентная находка/адъюдикация после allow) — прерываю"; \
		exit 1; \
	fi; \
	$(MAKE) --no-print-directory deploy-payload GATES_ARTIFACT="$$GATES_ARTIFACT" || exit 1; \
	$(MAKE) --no-print-directory verify-deployed GATES_ARTIFACT="$$GATES_ARTIFACT" || exit 1; \
	printf '%s\n' "$$REVIEWED_SHA" > .claude/.last-deployed-sha; \
	echo "✅ выкачен и проверен артефакт $$REVIEWED_SHA; baseline ревью обновлён"

# ── ОБЯЗАТЕЛЬНО переопредели оба таргета в своём Makefile ──────────────────────
# Скелет НЕ выкатывает: пока они не заменены, `make deploy` ПАДАЕТ. Иначе цель
# рапортовала бы успех и двигала baseline ревью на код, который никуда не уехал
# (находка ревью 09.08.2026: команды были аргументами echo, а baseline всё равно сдвигался).
# $(GATES_ARTIFACT) — tar, собранный ИЗ отревьюенного коммита, а не рабочее дерево.
deploy-payload:
	@echo "❌ deploy-payload не переопределён. Пример:"; \
	echo "   deploy-payload:"; \
	echo "   	mkdir -p build/payload && tar -xf \$$(GATES_ARTIFACT) -C build/payload"; \
	echo "   	rsync -a --delete build/payload/ host:/srv/app/"; \
	exit 1

verify-deployed:
	@echo "❌ verify-deployed не переопределён: baseline нельзя двигать, не проверив, что"; \
	echo "   выкаченное реально работает (healthcheck/версия на КАЖДОМ хосте)."; \
	exit 1

# Протокол сходимости (Фаза 1.6) — адъюдикация находок между раундами:
#   bash .githooks/gates-run codex_review_gate.py findings
#   bash .githooks/gates-run codex_review_gate.py adjudicate F1 fixed|residual-failsafe|refuted "причина"
# Аварийные обходы (аудируются): LADDER_SKIP=1 (лесенка), CODEX_REVIEW_SKIP=1 (Codex-часть).
