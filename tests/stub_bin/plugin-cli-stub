#!/bin/sh
# Заглушка для тестов. В прогоне тестов настоящий CLI управления плагинами обязан быть
# НЕДОСТИЖИМ, а не «неупомянут»: денилист написаний команды проваливался четыре раза подряд
# (argv[0]-only → мимо Popen/ssh; голое имя → уронило движок ревью; токенизация всего → ложные
# срабатывания на тексте промпта; токенизация командных позиций → мимо `bash -lc`, `env sh -c`,
# внуков через `python3 -`). Каталог со стабами стоит первым в PATH на всю сессию, поэтому
# перекрыты и внуки, и шеллы, и подстановки.
# Тесту, которому нужен рабочий подставной CLI, кладёт свой раньше в PATH (см. фикстуру fake_host).
echo "[тест-страж] $(basename "$0") $* — заблокировано: настоящий CLI управления плагинами в тестах недоступен" >&2
exit 97
